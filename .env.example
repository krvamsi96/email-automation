# =====================================================================
# Intelligent Email Copilot - Configuration
# =====================================================================

# Project Name
PROJECT_NAME=IntelligentEmailCopilot
COMPANY_NAME=Customer Support Team

# ---------------------------------------------------------------------
# AI providers: ollama | groq | gemini
# LLM_PROVIDER answers first; LLM_FALLBACK_PROVIDERS (comma-separated) are tried in
# order when it fails. Administrators can change the order and each provider's model at
# runtime in Settings -> Advanced (stored in the app database; overrides these values).
# A blank <PROVIDER>_MODEL means "the first chat model the provider lists".
# API keys stay on the server: they are never sent to the browser or written to logs.
# ---------------------------------------------------------------------
LLM_PROVIDER=groq
LLM_FALLBACK_PROVIDERS=gemini,ollama
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2000
# Seconds before one AI request attempt is abandoned, and extra attempts per provider
# for temporary failures (timeouts, rate limits, server errors)
LLM_TIMEOUT=60
LLM_RETRY_COUNT=1

# Ollama - local models, no key (https://ollama.com). Empty OLLAMA_BASE_URL disables it.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# Local models are slower (especially on a CPU); context window requested from Ollama
OLLAMA_TIMEOUT=300
OLLAMA_NUM_CTX=16384
# false = skip the reasoning phase of thinking models (much faster); true or empty = model default
OLLAMA_THINK=false

# Groq - hosted (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Seconds per attempt (empty = LLM_TIMEOUT); reasoning effort for reasoning models
# (low|medium|high; empty = model default. "low" made openai/gpt-oss-120b refuse answerable questions)
GROQ_TIMEOUT=
GROQ_REASONING_EFFORT=

# Google Gemini - hosted (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT=
# Thinking level for thinking models (minimal|low|medium|high; empty = model default), and
# extra output tokens reserved for thinking (Gemini counts thinking against the output limit)
GEMINI_THINKING_LEVEL=
GEMINI_THINKING_TOKENS=2048

# Local Embeddings & ChromaDB
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Similarity unrelated texts reach with the embedding model (empty = known value for the model)
EMBEDDING_SIMILARITY_FLOOR=
# Cross-encoder that re-ranks search results against the question ("none" = hybrid ranking only)
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
CHROMA_PERSIST_DIRECTORY=./data/chroma
KNOWLEDGE_BASE_PATH=./data/documents
# Chunking (characters; chunks are also kept within the embedding model's input window).
# Changing these or EMBEDDING_MODEL rebuilds the knowledge index automatically.
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
# Passages kept per search query / in total for one answer, and the maximum knowledge text per answer
RETRIEVAL_TOP_K=5
RETRIEVAL_MAX_CHUNKS=8
RETRIEVAL_MAX_CONTEXT_CHARS=12000

# LangGraph & Response Validation
MAX_RETRIES=2
MAX_EMAILS_PER_RUN=15
# Emails answered in parallel during one inbox check
EMAIL_CONCURRENCY=3

# Gmail OAuth & Credentials
GMAIL_CREDENTIALS_PATH=./credentials.json
GMAIL_TOKEN_PATH=./token.json
MY_EMAIL=

# Web application
PRODUCT_NAME=Intelligent Email Copilot
# Public URL of the web app (used for the Google sign-in redirect). Leave empty for local use.
PUBLIC_BASE_URL=
# Optional: key that unlocks Advanced Settings. Leave empty to allow only the local machine.
ADMIN_TOKEN=
# Optional: Fernet key used to encrypt stored Gmail sign-ins (generated automatically if empty)
APP_SECRET_KEY=
MAX_UPLOAD_MB=20
# Minimum knowledge match (0-1) required before the AI uses a document in a reply
RETRIEVAL_MIN_RELEVANCE=0.30
